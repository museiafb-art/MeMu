# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# --- Integraciones opcionales: dormidas hasta que su env exista (ver specs/06) ---

# Almacenamiento de audios (R2 en producción, MinIO en local)
# @optional @type=url
S3_ENDPOINT=
# @optional
S3_REGION=
# @optional
S3_BUCKET=
# @optional @sensitive
S3_ACCESS_KEY_ID=
# @optional @sensitive
S3_SECRET_ACCESS_KEY=

# Email transaccional (magic links, invitaciones)
# @optional @sensitive
RESEND_API_KEY=

# IA (transcripción / comandos de voz, Fase 3)
# @optional @sensitive
AI_GATEWAY_API_KEY=

# Señalización para los aparatos (avisos "hay audio nuevo")
# @optional @type=url
MQTT_URL=
# @optional
MQTT_USERNAME=
# @optional @sensitive
MQTT_PASSWORD=

# Push a celulares vía Expo (solo metadatos, nunca audios)
# @optional @sensitive
EXPO_ACCESS_TOKEN=
